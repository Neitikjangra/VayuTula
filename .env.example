# Copy to .env.local for local development. Never commit real values.
# Server-only Gemini key from Google AI Studio.
GEMINI_API_KEY=
# Gemini model id (Flash-class). Leave blank to use the app default.
GEMINI_MODEL=
# Air-quality provider: openmeteo (default) or googleaq (later, behind an adapter).
AIR_PROVIDER=openmeteo
