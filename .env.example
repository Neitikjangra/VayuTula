# Copy to .env.local for local development. Never commit real values.
# Server-only Gemini key from Google AI Studio.
GEMINI_API_KEY=
# Gemini model id (Flash-class). Leave blank for the default (gemini-3.8-flash).
GEMINI_MODEL=
# Tried when the main model is over quota or overloaded. Leave blank for gemini-3.5-flash-lite.
GEMINI_FALLBACK_MODEL=
# Air-quality provider: openmeteo (default) or googleaq (later, behind an adapter).
AIR_PROVIDER=openmeteo
